generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum FulfillmentType {
  local_delivery
  shipping
}

enum PaymentMethod {
  venmo
  paypal
  cash
  check
}

enum OrderStatus {
  pending_payment
  received
  processing
  ready
  shipped
  delivered
  cancelled
  refunded
}

enum PaymentLinkChannel {
  paypal
  venmo
}

model Product {
  id                 String       @id @default(uuid())
  name               String
  description        String
  price              Decimal      @db.Decimal(10, 2)
  batchSize          Int
  unitLabel          String
  imageUrl           String?
  active             Boolean      @default(true)
  createdAt          DateTime     @default(now())
  ingredients        String?
  supplyCostPerBatch Decimal?     @db.Decimal(10, 2)
  unitsAvailable     Int?
  orderItems         OrderItem[]
}

model Order {
  id                    String                 @id @default(uuid())
  firstName             String?
  lastName              String?
  customerEmail         String
  customerPhone         String
  fulfillmentType       FulfillmentType
  addressLine1          String?
  city                  String?
  state                 String?
  zip                   String?
  paymentMethod         PaymentMethod
  notes                 String?
  status                OrderStatus            @default(received)
  totalAmount           Decimal                @db.Decimal(10, 2)
  paypalOrderId         String?
  paypalCaptureId       String?
  paypalInvoiceId       String?
  cashCollected         Decimal?               @db.Decimal(10, 2)
  createdAt             DateTime               @default(now())
  orderItems            OrderItem[]
  customPaymentRequests CustomPaymentRequest[]
}

model CustomPaymentRequest {
  id              String             @id @default(cuid())
  orderId         String
  order           Order              @relation(fields: [orderId], references: [id])
  amount          Decimal            @db.Decimal(10, 2)
  channel         PaymentLinkChannel @default(paypal)
  paypalOrderId   String?
  paypalCaptureId String?
  paid            Boolean            @default(false)
  createdAt       DateTime           @default(now())
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  productId String
  quantity  Int
  unitPrice Decimal  @db.Decimal(10, 2)
  subtotal  Decimal  @db.Decimal(10, 2)
  order     Order    @relation(fields: [orderId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
}

model AdminVerificationCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  attempts  Int      @default(0)
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}
